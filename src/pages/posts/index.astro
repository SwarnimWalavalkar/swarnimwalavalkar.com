---
import { getCollection } from "astro:content";
import { sortPostsByDate } from "../../lib/date";

import BaseLayout from "../../layouts/BaseLayout.astro";
import PostPreview from "../../components/PostPreview.astro";

const posts = sortPostsByDate(
  await getCollection("posts", ({ data }) => data.isDraft !== true),
);

const groups = posts.reduce<
  { year: number; posts: typeof posts }[]
>((acc, post) => {
  const year = post.data.date.getFullYear();
  const last = acc[acc.length - 1];
  if (last && last.year === year) {
    last.posts.push(post);
  } else {
    acc.push({ year, posts: [post] });
  }
  return acc;
}, []);

const count = posts.length;
---

<BaseLayout title="Swarnim's Writing" description="Notes and essays by Swarnim Walavalkar">
  <main class="prose">
    <header class="mt-6 md:mt-8">
      <p
        class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-neutral-500"
      >
        <span>Writing</span>
        <span class="mx-2 text-neutral-700">·</span>
        <span class="text-neutral-600">
          {`${count} ${count === 1 ? "note" : "notes"}`}
        </span>
      </p>

      <h1 class="mt-3 !text-3xl !leading-[1.1] tracking-tight text-neutral-100">
        Notes from
        <span class="font-serif italic font-normal text-neutral-300">
          a workbench.
        </span>
      </h1>

      <p
        class="mt-3 max-w-[36ch] font-serif italic leading-snug text-neutral-400"
      >
        Things I&rsquo;m learning, building, and trying to think through. Some
        of it might be useful to you.
      </p>
    </header>

    <div class="mt-8 space-y-6 md:mt-10">
      {
        groups.map(({ year, posts: yearPosts }) => (
          <section>
            <h2 class="mb-1 flex items-center gap-3 !my-0">
              <span aria-hidden="true" class="h-px flex-1 bg-neutral-800/70" />
              <span class="font-mono text-xs tabular-nums text-neutral-500">
                {year}
              </span>
            </h2>
            <ul class="!my-0 divide-y divide-neutral-900/80 !list-none !pl-0">
              {yearPosts.map((post) => (
                <li class="!mb-0">
                  <PostPreview post={post} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
