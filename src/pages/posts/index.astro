---
import { getCollection } from "astro:content";
import { sortPostsByDate } from "../../lib/date";

import BaseLayout from "../../layouts/BaseLayout.astro";
import PostPreview from "../../components/PostPreview.astro";

const posts = sortPostsByDate(
  await getCollection("posts", ({ data }) => data.isDraft !== true),
);

const groups = posts.reduce<{ year: number; posts: typeof posts }[]>(
  (acc, post) => {
    const year = post.data.date.getFullYear();
    const last = acc[acc.length - 1];
    if (last && last.year === year) {
      last.posts.push(post);
    } else {
      acc.push({ year, posts: [post] });
    }
    return acc;
  },
  [],
);

const count = posts.length;
const latestSlug = posts[0]?.slug;
---

<BaseLayout
  title="Swarnim's Writing"
  description="Notes and essays by Swarnim Walavalkar"
>
  <main class="prose">
    <header class="mt-6 md:mt-8">
      <p
        class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-neutral-500"
      >
        <span class="text-neutral-400">A workbench journal</span>
        <span aria-hidden="true" class="mx-2 text-neutral-700">·</span>
        <span class="text-neutral-600">
          {`${count} ${count === 1 ? "note" : "notes"}`}
        </span>
      </p>

      <h1
        class="mt-3 !text-3xl !leading-[1.1] tracking-tight text-neutral-100"
      >
        Notes from
        <span class="font-serif italic font-normal text-neutral-300">
          a workbench.
        </span>
      </h1>

      <p
        class="mt-3 max-w-[36ch] font-serif italic leading-snug text-neutral-400"
      >
        Things I&rsquo;m learning, building, and trying to think through. Some
        of it might be useful to you.
      </p>
    </header>

    <div class="mt-10 md:mt-12">
      {
        groups.map(({ year, posts: yearPosts }, gi) => (
          <section class:list={["!my-0", gi > 0 ? "mt-10 sm:mt-12" : ""]}>
            <h2 class="!my-0 flex items-baseline gap-4">
              <span
                class="font-mono text-xs !font-normal uppercase tracking-[0.22em] tabular-nums text-neutral-300"
              >
                {year}
              </span>
              <span
                aria-hidden="true"
                class="h-px flex-1 bg-neutral-800/70"
              />
              <span
                class="font-serif text-[13px] italic font-normal text-neutral-500"
              >
                {yearPosts.length}{" "}
                {yearPosts.length === 1 ? "note" : "notes"}
              </span>
            </h2>

            <ul class="!my-0 mt-1 divide-y divide-neutral-900/70 !list-none !pl-0">
              {yearPosts.map((post) => (
                <li class="!mb-0">
                  <PostPreview
                    post={post}
                    isLatest={post.slug === latestSlug}
                  />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
