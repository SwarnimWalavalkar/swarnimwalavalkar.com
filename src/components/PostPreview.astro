---
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../lib/reading-time";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { title, description, date, tags } = post.data;
const minutes = readingTime(post.body);

const monthDay = date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
});

const showDescription =
  description && description.trim().toLowerCase() !== title.trim().toLowerCase();
---

<article class="group/post relative">
  <a
    href={`/posts/${post.slug}`}
    class="grid grid-cols-[5.5rem_1fr] gap-x-5 py-3 sm:gap-x-7"
  >
    <div
      class="pt-[3px] font-mono text-[11px] uppercase tracking-[0.18em] text-neutral-500 tabular-nums"
    >
      <div>{monthDay}</div>
      <div class="mt-0.5 text-neutral-600">{minutes} min</div>
    </div>

    <div class="min-w-0">
      <h2
        class="text-base font-semibold leading-snug text-neutral-200 transition-colors duration-200 group-hover/post:text-white sm:text-[17px]"
      >
        {title}
      </h2>
      {
        showDescription && (
          <p class="mt-1 font-serif italic leading-snug text-neutral-400 transition-colors duration-200 group-hover/post:text-neutral-300">
            {description}
          </p>
        )
      }
      {
        tags.length > 0 && (
          <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10.5px] uppercase tracking-[0.18em] text-neutral-600">
            {tags.map((tag, i) => (
              <>
                {i > 0 && (
                  <span aria-hidden="true" class="text-neutral-700">
                    ·
                  </span>
                )}
                <span>{tag}</span>
              </>
            ))}
          </div>
        )
      }
    </div>
  </a>
</article>
