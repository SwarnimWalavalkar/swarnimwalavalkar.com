---
import type { DeviceKind } from "../data/tools";
type Props = { kind: DeviceKind };
const { kind } = Astro.props;
---

<svg
  viewBox="0 0 100 76"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    kind === "laptop" && (
      <>
        <rect
          x="17"
          y="8"
          width="66"
          height="46"
          rx="1.5"
          stroke-width="1"
          fill="currentColor"
          fill-opacity=".035"
        />
        <path d="M19 10h27v2h8v-2h27v42H19Z" stroke-width=".6" opacity=".5" />
        <circle
          cx="50"
          cy="10.8"
          r=".35"
          fill="currentColor"
          stroke="none"
          opacity=".55"
        />
        <path d="M17 54 9 58h82l-8-4" stroke-width="1" />
        <path
          d="M9 58 11 60h78l2-2"
          stroke-width="1"
          fill="currentColor"
          fill-opacity=".08"
        />
        <path d="M44 58v1h12v-1" stroke-width=".6" opacity=".65" />
        <path d="M40 55.5h20l1.5 1.5h-23Z" stroke-width=".5" opacity=".3" />
      </>
    )
  }
  {
    kind === "board" && (
      <>
        <rect
          x="16"
          y="14"
          width="68"
          height="48"
          rx="4"
          fill="currentColor"
          fill-opacity=".035"
        />
        <rect x="38" y="26" width="23" height="23" rx="2" />
        <path
          d="M42 22v4m5-4v4m5-4v4m5-4v4M42 49v4m5-4v4m5-4v4m5-4v4M34 31h4m-4 5h4m-4 5h4m-4 5h4M61 31h4m-4 5h4m-4 5h4m-4 5h4"
          opacity=".55"
        />
        <path d="M72 21h15v13H72zM72 40h15v13H72zM25 18v8m0 5v8m0 5v8M35 61v5h23v-5" />
        <>
          <circle cx="21" cy="57" r="1" />
          <circle cx="79" cy="57" r="1" />
        </>
      </>
    )
  }
  {
    kind === "desktop" && (
      <g stroke-width="1" stroke-linejoin="miter">
        <path
          d="M23 10 62 5l15 9-3 50-37 7-14-10Z"
          fill="currentColor"
          fill-opacity=".025"
        />
        <path d="m23 10 14 9 40-5M37 19v52" />
        <path d="m45 23 27-5-2.5 43-26 5Z" stroke-width=".7" opacity=".55" />
        <path d="m27 18 5 4v39l-5-4Z" stroke-width=".6" opacity=".2" />
        {[29, 43, 57].map((y) => (
          <g transform={`translate(57 ${y}) skewY(-10)`} opacity=".45">
            <circle r="7.5" stroke-width=".7" />
            <circle r="1.7" fill="currentColor" stroke="none" />
            <path
              d="M0-2C-4-6-5-2-5 0M2 0C6-4 2-5 0-5M0 2C4 6 5 2 5 0M-2 0C-6 4-2 5 0 5"
              stroke-width="1.3"
              opacity=".5"
            />
          </g>
        ))}
        {[25, 31, 37, 43, 49, 55, 61].map((y) => (
          <path d={`M38.5 ${y}l3-2v3l-3 2`} stroke-width=".7" opacity=".55" />
        ))}
        <path
          d="m47 27 22-4m-22 10 22-4m-23 10 23-4m-23 10 22-4m-22 10 22-4m-23 10 23-4"
          stroke-width=".5"
          opacity=".12"
        />
        <path
          d="m38 12 4-.6m3-.4 4-.6m12-1.7 2-.3"
          stroke-width="1.5"
          opacity=".6"
        />
        <ellipse
          cx="55"
          cy="10"
          rx="2"
          ry="1.1"
          stroke-width=".7"
          opacity=".65"
        />
        <path
          d="m53 65 6-1M27 64v2l5 3v-3m34 0v2l5-1v-2"
          stroke-width=".8"
          opacity=".6"
        />
      </g>
    )
  }
  {
    kind === "server" && (
      <>
        <rect
          x="18"
          y="17"
          width="64"
          height="18"
          rx="3"
          fill="currentColor"
          fill-opacity=".035"
        />
        <rect
          x="18"
          y="41"
          width="64"
          height="18"
          rx="3"
          fill="currentColor"
          fill-opacity=".035"
        />
        <>
          <circle cx="28" cy="26" r="2" />
          <circle cx="28" cy="50" r="2" />
        </>
        <path
          d="M42 26h28M42 50h28M25 35v6m50-6v6M30 59v5m40-5v5"
          opacity=".5"
        />
      </>
    )
  }
  {
    kind === "phone" && (
      <>
        <rect
          x="34"
          y="6"
          width="32"
          height="64"
          rx="6"
          fill="currentColor"
          fill-opacity=".035"
        />
        <>
          <path d="M44 12h12M45 64h10" opacity=".55" />
          <circle cx="50" cy="38" r="9" opacity=".35" />
        </>
        <path d="m46 38 3 3 6-7" opacity=".65" />
      </>
    )
  }
</svg>
